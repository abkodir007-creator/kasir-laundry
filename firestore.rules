rules_version = '2';

/* Aturan akses Firestore untuk Kasir StarWash Laundry.

   Prinsipnya satu kalimat: hanya akun yang terdaftar di daftar UID di bawah
   yang boleh membaca dan menulis data toko. Selain itu ditolak, termasuk
   orang yang berhasil membuat akun sendiri di project ini.

   Cara memasang: Firebase Console -> Firestore Database -> tab Rules ->
   ganti seluruh isinya dengan berkas ini -> Publish.

   CATATAN: UID akun toko sengaja TIDAK ditulis di berkas ini, karena
   penyimpanan kode ini bersifat publik. UID memang bukan kata sandi dan
   tidak memberi akses apa pun tanpa kata sandi, tapi menuliskannya di
   tempat terbuka sama saja memberi tahu penyerang akun mana yang harus
   ditebak. Yang berlaku adalah aturan yang dipasang di Firebase Console;
   berkas ini adalah cetakannya.

   Ganti UID_TOKO_ANDA dengan UID akun toko sebelum menekan Publish. UID ada
   di Authentication -> Users, kolom "User UID". Boleh lebih dari satu kalau
   nanti ada cabang dengan akun berbeda. */

service cloud.firestore {
  match /databases/{database}/documents {

    // Daftar akun yang boleh membuka data toko.
    function bolehMasuk() {
      return request.auth != null && request.auth.uid in [
        'UID_TOKO_ANDA'
      ];
    }

    // Seluruh data toko berada di bawah satu dokumen induk, sehingga satu
    // aturan ini sudah mencakup pesanan, pengeluaran, pelanggan, layanan,
    // pengguna, dan pengaturan toko.
    match /toko/{tokoId}/{document=**} {
      allow read, write: if bolehMasuk();
    }

    // Apa pun di luar itu ditolak, tanpa kecuali.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
